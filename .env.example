# Search indexing is intentionally opt-in. Set true only on the canonical production deployment
# after the launch checklist has passed.
ALLOW_INDEXING=false

# Canonical public URL. Vercel currently redirects roofhub.co.nz -> www.roofhub.co.nz.
NEXT_PUBLIC_SITE_URL=https://www.roofhub.co.nz

# Optional verification / analytics
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# Enquiry delivery. These are server-only; never prefix them NEXT_PUBLIC_.
ROOFHUB_INQUIRY_TO=insights@t3labs.co.uk
ROOFHUB_FROM_EMAIL=
RESEND_API_KEY=
