{
  "version": "1.0.0",
  "rule": "Reuse these component families and variants before creating new UI primitives.",
  "components": {
    "Button": {"variants":["primary","secondary","outline","ghost","text"],"sizes":["small","medium","large"],"requiredStates":["default","hover","focus","disabled","loading"]},
    "Input": {"variants":["text","email","search","number","select","textarea","checkbox","radio","toggle","file"],"requiredStates":["default","focus","populated","disabled","success","error"]},
    "Card": {"variants":["guide","tool","result","material","resource","methodology","stat","provider"]},
    "Notice": {"variants":["info","success","warning","error","preliminary"]},
    "CTA": {"variants":["inline","fullWidth","toolResult","askRoofHub"]},
    "Navigation": {"variants":["desktopHeader","mobileHeader","footer","breadcrumbs"]},
    "Disclosure": {"variants":["tabs","accordion"]},
    "DataDisplay": {"variants":["comparisonTable","dataTable","metric","range","assumptionList"]},
    "Section": {"variants":["heroEditorial","heroTool","heroSplit","trustBar","featureGrid","toolGrid","resultSummary","methodology","contentSidebar","comparison","process","faq","relatedResources","imageContent","enquiryPrompt","fullWidthCTA"]}
  }
}
